        },
        "graduation_year": {
          "$ref": "#/$defs/ExtractedField"
        },
        "item_model_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Model Confidence"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "degree_type",
        "field",
        "institution",
        "start_year",
        "end_year",
        "graduation_year"
